# Copy to a private .env for development, or install as
# /etc/dns-noc-bot/dns-noc-bot.env for systemd.
# All addresses below are documentation examples (RFC 5737).
BOT_TOKEN=replace_with_your_telegram_bot_token
PROM_URL=http://192.0.2.10:9090

# Prometheus node_exporter instance labels: host:port.
DNS1_NODE_EXPORTER=192.0.2.20:9100
DNS2_NODE_EXPORTER=192.0.2.21:9100
CONNTRACK_NODE_EXPORTER=192.0.2.10:9100

# Numeric Telegram user and chat IDs, separated by commas.
# All commands require BOTH an allowed user and an allowed chat.
# A private chat ID normally equals your numeric user ID.
# A Telegram supergroup chat ID is usually negative (-100...).
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_CHAT_IDS=123456789
